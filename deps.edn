             metosin/reitit                    {:mvn/version "0.9.2"}
             metosin/reitit-ring               {:mvn/version "0.9.2"}
             metosin/muuntaja                  {:mvn/version "0.6.11"}
             http-kit/http-kit                 {:mvn/version "2.8.1"}
             com.github.seancorfield/next.jdbc {:mvn/version "1.3.1086"}
             com.github.seancorfield/honeysql  {:mvn/version "2.7.9999-SNAPSHOT"}
             com.taoensso/nippy                {:mvn/version "3.6.0"}
             com.taoensso/timbre               {:mvn/version "6.8.0"}
             buddy/buddy-auth                  {:mvn/version "3.0.323"}
             buddy/buddy-sign                  {:mvn/version "3.6.1-359"}
             clj-http/clj-http                 {:mvn/version "3.13.1"}
             org.clojure/core.async            {:mvn/version "1.8.741"}
             aero/aero                         {:mvn/version "1.1.6"}
             org.apache.kafka/kafka-clients    {:mvn/version "3.9.0"}}
   :aliases {
             ;; nREPL server for AI to connect to
             ;; Include all paths you want available for development
             :nrepl {:extra-paths ["test"]
                     :extra-deps  {nrepl/nrepl {:mvn/version "1.5.1"}}
