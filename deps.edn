{:paths     ["src/clj" "src/cljs" "src/shared" "resources" "target/classes"]
 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}
 :deps
 {;; --- Core language / utilities ---
  org.clojure/clojure               {:mvn/version "1.12.3"}
  org.clojure/core.async            {:mvn/version "1.8.741"}

  ;; --- Web / routing / schemas ---
  ring/ring-core                    {:mvn/version "1.15.3"}
  ring/ring-jetty-adapter           {:mvn/version "1.15.3"} ; Jetty HTTP server (optional)
  metosin/reitit                    {:mvn/version "0.9.2"}  ; routing + coercion
  metosin/malli                     {:mvn/version "0.20.0"} ; schemas/coercion
  metosin/jsonista                  {:mvn/version "0.3.13"} ; fast JSON (Jackson)
  ring/ring-codec                   {:mvn/version "1.3.0"}  ; for ring.util.response/resource-response

  ;; --- WebSockets + HTTP server ---
  http-kit/http-kit                 {:mvn/version "2.8.1"}  ; WS server + http

  ;; --- Lifecycle / DI ---
  integrant/integrant               {:mvn/version "1.0.1"}

  ;; --- Logging ---
  ;;org.clojure/tools.logging {:mvn/version "1.3.1"}
  ;;org.slf4j/slf4j-api               {:mvn/version "2.0.17"}
  ;;ch.qos.logback/logback-classic    {:mvn/version "1.5.21"} ; slf4j backend
  ;;org.apache.logging.log4j/log4j-ap {:mvn/version "2.25.3"}
  ;;org.apache.logging.log4j/log4j-core {:mvn/version "2.25.3"}
  com.github.seancorfield/logging4j2 {:mvn/version "1.0.6"}

  ;; --- DB (Postgres) ---
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1086"}
  com.github.seancorfield/honeysql  {:mvn/version "2.7.9999-SNAPSHOT"}
  com.zaxxer/HikariCP               {:mvn/version "7.0.2"}
  org.postgresql/postgresql         {:mvn/version "42.7.8"}

  ;; --- UUID ---
  ;; Used for UUIDv7 generation (time-ordered UUIDs).
  com.github.f4b6a3/uuid-creator    {:mvn/version "6.1.0"}

  ;; --- Kafka producer (Java client) ---
  org.apache.kafka/kafka-clients    {:mvn/version "4.1.1"}

  ;; --- OpenTelemetry API (needed at compile/runtime even when using Java agent) ---
  ;; NOTE: API artifacts use the 1.x version line; the Java agent version (e.g. v2.11.0)
  ;; is a different release stream.
  io.opentelemetry/opentelemetry-api     {:mvn/version "1.59.0"}
  io.opentelemetry/opentelemetry-context {:mvn/version "1.59.0"}

  ;; --- Auth / OIDC (Keycloak) ---
  ;; NOTE: keycloak-clojure is kept for now (may still be useful for admin APIs),
  ;; but our JWT verification uses Nimbus directly for transparency and control.
  keycloak-clojure/keycloak-clojure {:mvn/version "1.31.5"
                                     :exclusions [com.google.cloud/google-cloud-secretmanager]}
  com.nimbusds/nimbus-jose-jwt      {:mvn/version "10.7"}

  ;; --- gRPC client stack (Java stubs) ---
  io.grpc/grpc-netty-shaded         {:mvn/version "1.77.0"}
  io.grpc/grpc-protobuf             {:mvn/version "1.77.0"}
  io.grpc/grpc-stub                 {:mvn/version "1.77.0"}
  ;; Must be >= the version used by generated Java stubs (buf).
  ;; Keep in sync with the generated gencode version to avoid runtime init failures.
  com.google.protobuf/protobuf-java {:mvn/version "4.34.1"}

  ;; --- S3 enrollment storage ---
  software.amazon.awssdk/s3         {:mvn/version "2.32.21"}
  software.amazon.awssdk/auth       {:mvn/version "2.32.21"}
  software.amazon.awssdk/regions    {:mvn/version "2.32.21"}

  ;; Multipart parsing is provided by ring-core.
  }

 :aliases
 {:nrepl {:extra-paths ["src/clj" "resources" "test"]
          :extra-deps  {nrepl/nrepl {:mvn/version "1.5.1"}}
          :main-opts   ["-m" "nrepl.cmdline" "--port" "7888"]}
  ;; REPL niceties
  :dev
  {:extra-paths ["src/clj" "resources" "dev"]
   :extra-deps  {nrepl/nrepl                 {:mvn/version "1.5.1"}
                 cider/cider-nrepl           {:mvn/version "0.58.0"}
                 org.clojure/tools.namespace {:mvn/version "1.5.0"}}
   :jvm-opts ["-Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager"]}

  ;; ClojureScript build (shadow-cljs + hsx)
  ;; Requires npm deps installed (see package.json).
  ;; Examples:
  ;;   clojure -M:cljs watch app
  ;;   clojure -M:cljs release app
  :cljs
  {:extra-paths ["src/cljs" "resources"]
   :extra-deps  {thheller/shadow-cljs {:mvn/version "3.3.4"}
                 io.factorhouse/hsx   {:mvn/version "0.1.24"}}
   :main-opts   ["-m" "shadow.cljs.devtools.cli"]}

  ;; Unit + integration tests
  :test
  {:extra-paths ["test" "test-resources"]
   :extra-deps  {org.clojure/test.check                  {:mvn/version "1.1.2"}
                 com.github.seancorfield/expectations    {:mvn/version "2.2.214"}
                 io.github.cognitect-labs/test-runner    {:git/tag "v0.5.1" :git/sha "dfb30dd"}

                 ;; WebSocket client for integration tests
                 com.neovisionaries/nv-websocket-client  {:mvn/version "2.14"}

                 ;; Ring mock request helpers
                 ring/ring-mock                          {:mvn/version "0.5.0"}

                 ;; Testcontainers (Java) + modules
                 org.testcontainers/testcontainers       {:mvn/version "2.0.2"}
                 org.testcontainers/postgresql           {:mvn/version "1.21.3"}
                 org.testcontainers/kafka                {:mvn/version "1.21.3"}
                 org.testcontainers/localstack           {:mvn/version "1.21.3"}

                 ;; Clojure wrapper (one option)
                 clj-test-containers/clj-test-containers {:mvn/version "0.7.4"}

                 ;; Etaoin for E2E browser tests
                 etaoin/etaoin                           {:mvn/version "1.1.43"}
                 cheshire/cheshire                       {:mvn/version "6.1.0"}}
   :exec-fn cognitect.test-runner.api/test}

  ;; CI (PR gate): run only non-Testcontainers tests
  ;;
  ;; This exists so our PR CI does NOT require Docker.
  ;; Heavy integration tests are covered by the manual/nightly workflow.
  :ci
  {:extra-paths ["test" "test-resources"]
   :extra-deps  {org.clojure/test.check               {:mvn/version "1.1.2"}
                 io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}

                 ;; Needed for lightweight WS integration tests (no Docker).
                 com.neovisionaries/nv-websocket-client {:mvn/version "2.14"}}
   :exec-fn samuraibff.ci.test-plan/run}
  :jvm-opts ["-Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager"]

  ;; Run main
  :run
  {:main-opts ["-m" "samuraibff.core"]}

  ;; Build (optional; good to have early)
  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.12"}}
   :ns-default build}}}

#_{:deps    {org.clojure/clojure               {:mvn/version "1.12.4"}
