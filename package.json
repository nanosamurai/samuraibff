{
  "name": "samuraibff-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "shadow-cljs": "3.3.4",
    "wait-on": "8.0.5"
  },
  "dependencies": {
    "@js-joda/core": "3.2.0",
    "@js-joda/locale_en-us": "3.1.1",
    "@js-joda/timezone": "2.5.0",
    "flag-icons": "7.5.0",
    "markdown-it": "14.3.0",
    "markdown-it-block-image": "0.0.3",
    "markdown-it-footnote": "3.0.3",
    "markdown-it-texmath": "1.0.0",
    "markdown-it-toc-done-right": "4.2.0",
    "punycode": "2.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "test": "node --test electron/*.test.cjs",
    "flags:sync": "node tools/flags-sync.cjs",
    "ui:watch": "npm run -s flags:sync && shadow-cljs watch app",
    "ui:watch:or-attach": "npm run -s flags:sync && node tools/ui-watch-or-attach.cjs",
    "ui:release": "npm run -s flags:sync && shadow-cljs release app",
    "electron:dev": "concurrently -k -n ui,electron -c cyan,magenta \"npm run ui:watch:or-attach\" \"npx.cmd electron electron/main.cjs\"",
    "electron:dist": "npm run ui:release && electron-builder -c electron-builder.yml"
  }
}
