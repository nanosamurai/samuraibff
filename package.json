{
  "name": "samuraibff-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "devDependencies": {
    "shadow-cljs": "3.3.4",
    "concurrently": "9.2.1",
    "wait-on": "8.0.5",
    "electron": "34.4.0",
    "electron-builder": "26.0.12"
  },
  "dependencies": {
    "@js-joda/core": "3.2.0",
    "@js-joda/locale_en-us": "3.1.1",
    "@js-joda/timezone": "2.5.0",
    "markdown-it": "14.1.0",
    "markdown-it-block-image": "0.0.3",
    "markdown-it-footnote": "3.0.3",
    "markdown-it-texmath": "1.0.0",
    "markdown-it-toc-done-right": "4.2.0",
    "punycode": "2.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "ui:watch": "shadow-cljs watch app",
    "ui:watch:or-attach": "node tools/ui-watch-or-attach.cjs",
    "ui:release": "shadow-cljs release app",

    "electron:dev": "concurrently -k -n ui,electron -c cyan,magenta \"npm run ui:watch:or-attach\" \"npx.cmd electron electron/main.cjs\"",
    "electron:dist": "npm run ui:release && electron-builder -c electron-builder.yml"
  }
}
