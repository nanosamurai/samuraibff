{:samuraibff/config
 {:env :dev

  ;; --- HTTP / WS ---
  ;; We can run both HTTP and WS on http-kit (recommended for simplicity).
  ;; Leaving both sections here keeps it flexible.
  ;; Safe-by-default: bind to localhost. Override in k8s via SAMURAIBFF_HTTP_HOST=0.0.0.0
  :http {:host "127.0.0.1"
         :port 8000}

  ;; Safe-by-default: bind to localhost. Override in k8s via SAMURAIBFF_WS_HOST=0.0.0.0
  :ws   {:host "127.0.0.1"
         :port 8000}

  ;; --- Edition / product feature flags ---
  ;; Community Edition mode hides/disables workflow and webhook runtime features.
  ;; Commercial deployments should set SAMURAIBFF_CE_MODE=false.
  :features {:ce-mode? true}

  ;; --- Auth / Keycloak ---
  :auth {:required? true
         ;; Optional dev/test-only fallback used ONLY when :required? is false.
         ;; When enabled, unauthenticated WS sessions will still be isolated and
         ;; audio/raw Kafka messages will carry AudioChunk.tenant_id.
         ;;
         ;; Recommended value for local dev:
         ;; "00000000-0000-0000-0000-000000000000"
         :guest-tenant-id nil
         :issuer "https://auth.nanosamur.ai/realms/nanosamurai"
         ;; JWT audience (Keycloak client id used by the browser)
         :audience "bff-web"
         ;; OAuth client id for /auth/login (defaults to :audience if omitted)
         :client-id "bff-web"
         ;; Access token cookie name used by the UI login flow
         :cookie-name "access_token"
         ;; where to find tenant in claims; we’ll standardize on this later
         :tenant-claim "tenant_id"}

  ;; --- Keycloak Admin API (optional; required only for managing M2M credentials) ---
  ;; If not set, /api/api-credentials will return 503 (keycloak-admin-unavailable).
  :keycloak {:admin {:issuer "https://auth.nanosamur.ai/realms/nanosamurai"
                     :realm "nanosamurai"
                     :client-id "bff-admin"
                     :client-secret nil}}

  ;; --- DB ---
  ;; NOTE: do not ship real credentials in a jar-packaged resources/system.edn.
  ;; Provide these via SAMURAIBFF_DB_* env vars or SAMURAIBFF_CONFIG_PATH.
  :db {:jdbc-url "jdbc:postgresql://localhost:5432/nanosamurai"
       :username "drsynth"
       :password "drsynth"
       :maximum-pool-size 10}

  ;; --- Kafka ---
  :kafka {:bootstrap-servers "localhost:9092"
          :client-id "samuraibff"
          :acks "all"
          :compression-type "zstd"
          ;; consumer group id for transcripts.refined
          :consumer-group-id "samuraibff-refined"
          :topics {:audio-raw "audio.raw"
                   :refined "transcripts.refined"
                    :workflow-result "workflow.result"
                   ;; Compacted session routing snapshot (webhook egress RFC).
                   :sessions-meta "sessions.meta"}}

  ;; --- BFF instance identity (reply-to) ---
  ;; In production you MUST set :origin-uri to an address other BFF instances can reach.
  ;; In dev, if omitted, we derive from [:http :host]/[:http :port].
  ;; IMPORTANT:
  ;; `:origin-uri` is also used to build the OIDC redirect_uri for /auth/callback.
  ;; Keycloak compares redirect_uri *exactly* against the client's "Valid redirect URIs".
  ;; If your Keycloak client allows only http://localhost:8000/* then keep localhost here.
  :bff {:origin-uri "http://localhost:8000"
         ;; Refined transcript forwarding between BFF instances.
         :callback-path "/internal/refined"
         ;; Workflow result forwarding between BFF instances.
         ;; (If not set, consumer falls back to /internal/workflow-result)
         :callback-path-workflow-result "/internal/workflow-result"}

  ;; --- gRPC ---
  :grpc {:rtservice-addr "localhost:50052"}

  ;; --- S3 / object storage (enrollments + recordings playback) ---
  ;;
  ;; Credentials:
  ;; - In production we expect IAM (IRSA / instance roles), so access/secret keys
  ;;   are typically NOT configured.
  ;; - For localstack/minio/ceph, configure :endpoint and (optionally) static keys.
  ;;
  ;; Buckets:
  ;; - Enrollments layout:
  ;;   s3://<enrollments-bucket>/<enrollment-prefix>/<tenant_id>/speakers/<speaker_id>/
  ;;     speaker.json
  ;;     samples/<sample_id>.wav
  ;;
  ;; - Recordings playback uses `recordings.recording_url` stored in Postgres
  ;;   as either:
  ;;     file://...
  ;;     s3://<recordings-bucket>/<key>
  ;;   and the BFF streams the bytes to the browser via
  ;;     GET /api/recordings/:session_id/audio
  :s3 {:region ""
       :endpoint "http://localhost:4566"            ;; localstack/minio/ceph (e.g. http://localhost:4566)
       :access-key ""
       :secret-key ""
       :force-path-style? true
       :buckets {:enrollments {:bucket "xamurai-enrollment"
                               :prefix "enrollment"}
                 :recordings  {:bucket "xamurai-recordings"
                               :prefix "recordings"}}}

  ;; --- Recordings playback (audio) ---
  ;; Used by GET /api/recordings/:session_id/audio.
  ;;
  ;; Security:
  ;; - `recordings.recording_url` may be `file://...` or `s3://...`.
  ;; - We do NOT expose these URLs directly to the browser.
  ;; - For file:// URLs, we only allow paths under `:recordings :local-root`.
  :recordings {:local-root ""}

  ;; --- Secrets (webhook auth) ---
  ;; Customer-managed webhook secrets must be write-only and must not be stored in Postgres.
  ;;
  ;; Backends:
  ;; - :aws-secrets-manager (default; use LocalStack in dev/test)
  ;; - :k8s-secrets (optional; recommended for high-cardinality secret sets)
  :secrets {:backend :aws-secrets-manager
            :aws {:region ""
                  :endpoint "http://localhost:4566"
                  :access-key ""
                  :secret-key ""
                  ;; Optional: KMS key id/arn for envelope encryption.
                  :kms-key-id nil
                  :name-prefix "nanosamurai"}
            :k8s {:namespace "default"
                  :key "value"
                  :name-prefix "nanosamurai"}}}

 ;; --- Integrant components ---

 :samuraibff/db
 {:config #ig/ref :samuraibff/config}

 :samuraibff/kafka-producer
 {:config #ig/ref :samuraibff/config}

 :samuraibff/grpc-client
 {:config #ig/ref :samuraibff/config}

 :samuraibff/ws-registry
 {:config #ig/ref :samuraibff/config
  :kafka-producer #ig/ref :samuraibff/kafka-producer}

 :samuraibff/refined-consumer
 {:config #ig/ref :samuraibff/config
  :ws-registry #ig/ref :samuraibff/ws-registry}

  :samuraibff/workflow-results-consumer
  {:config #ig/ref :samuraibff/config
   :ws-registry #ig/ref :samuraibff/ws-registry}

 :samuraibff/router
 {:config      #ig/ref :samuraibff/config
  :db          #ig/ref :samuraibff/db
  :kafka-producer #ig/ref :samuraibff/kafka-producer
  :ws-registry #ig/ref :samuraibff/ws-registry
  :grpc        #ig/ref :samuraibff/grpc-client
  :keycloak-admin #ig/ref :samuraibff/keycloak-admin
  :secrets #ig/ref :samuraibff/secrets}

 :samuraibff/keycloak-admin
 {:config #ig/ref :samuraibff/config}

 :samuraibff/secrets
 {:config #ig/ref :samuraibff/config}

 :samuraibff/http-server
 {:config  #ig/ref :samuraibff/config
  :handler #ig/ref :samuraibff/router}}
