{:samuraibff/config
 {:env :dev

  ;; --- HTTP / WS ---
  ;; We can run both HTTP and WS on http-kit (recommended for simplicity).
  ;; Leaving both sections here keeps it flexible.
  :http {:host "0.0.0.0"
         :port 8000}

  :ws   {:host "0.0.0.0"
         :port 8000}

  ;; --- Auth / Keycloak ---
  :auth {:required? false
         :issuer "https://auth.nanosamur.ai/realms/nanosamurai"
         :audience "bff-web"
         ;; where to find tenant in claims; we’ll standardize on this later
         :tenant-claim "tenant_id"}

  ;; --- DB ---
  :db {:jdbc-url "jdbc:postgresql://localhost:5432/drsynth"
       :username "drsynth"
       :password "drsynth"
       :maximum-pool-size 10}

  ;; --- Kafka ---
  :kafka {:bootstrap-servers "localhost:9092"
          :client-id "samuraibff"
          :acks "all"
          :compression-type "zstd"
          :topics {:audio-raw "audio.raw"
                   ;; refined will come via HTTP callback instead of Kafka consume
                   :refined-callback "transcripts.refined.callback"}}

  ;; --- gRPC ---
  :grpc {:rtservice-addr "localhost:50052"}}

 ;; --- Integrant components ---

 ;; NOTE: DB / Kafka / session-registry components are intentionally not
 ;; wired yet (separate PR). Keep this system.edn minimal so `samuraibff.system`
 ;; can start the HTTP+WS+gRPC pipeline.

 :samuraibff/grpc-client
 {:config #ig/ref :samuraibff/config}

 :samuraibff/ws-registry
 {:config #ig/ref :samuraibff/config}

 :samuraibff/router
 {:config      #ig/ref :samuraibff/config
  :ws-registry #ig/ref :samuraibff/ws-registry
  :grpc        #ig/ref :samuraibff/grpc-client}

 :samuraibff/http-server
 {:config  #ig/ref :samuraibff/config
  :handler #ig/ref :samuraibff/router}}
