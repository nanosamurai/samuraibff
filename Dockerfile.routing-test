# syntax=docker/dockerfile:1

FROM clojure:temurin-21-tools-deps

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL "https://github.com/bufbuild/buf/releases/download/v1.57.2/buf-Linux-x86_64" -o /usr/local/bin/buf \
    && chmod +x /usr/local/bin/buf \
    && rm -rf /var/lib/apt/lists/*

COPY deps.edn build.clj buf.yaml buf.gen.yaml ./
RUN clojure -P

COPY resources/proto resources/proto
COPY src/clj src/clj
COPY utilities utilities

RUN clojure -T:build proto+compile

CMD ["clojure", "-M:routing-probe"]
